@using MonitorLab.Web.Models.MonitorViewModels
@model IEnumerable<MonitorCardViewModel>

@{
    ViewData["Title"] = "Админ панел - Монитори";
}

<section class="admin-panel-page">
    <div class="admin-panel-header">
        <span class="admin-login-badge">MonitorLab Admin</span>
        <h1>Управление на монитори</h1>
        <p>Преглед, добавяне, редакция и изтриване на мониторите в каталога.</p>
    </div>

    <div class="admin-actions-bar">
        <a asp-area="Admin"
               asp-controller="Monitors"
               asp-action="Create"
               class="admin-add-btn">
            <i class="bi bi-plus-circle"></i>
            Добави монитор
        </a>
    </div>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Модел</th>
                    <th>Резолюция</th>
                    <th>Панел</th>
                    <th>Hz</th>
                    <th>Яркост</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var monitor in Model)
                {
                    <tr>
                        <td>
                            <strong>@monitor.Brand @monitor.Model</strong>
                        </td>
                        <td>@monitor.Resolution</td>
                        <td>@monitor.PanelType</td>
                        <td>@monitor.RefreshRateHz Hz</td>
                        <td>@monitor.BrightnessNits nits</td>
                        <td>
                            <div class="admin-row-actions">
                                <a asp-area="Admin"
                                       asp-controller="Monitors"
                                       asp-action="Edit"
                                       asp-route-id="@monitor.Id"
                                       class="admin-edit-btn">
                                    <i class="bi bi-pencil-square"></i>
                                    Промяна
                                </a>

                                <a asp-area="Admin"
                                       asp-controller="Monitors"
                                       asp-action="Delete"
                                       asp-route-id="@monitor.Id"
                                       class="admin-delete-btn">
                                    <i class="bi bi-trash"></i>
                                    Изтрий
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>