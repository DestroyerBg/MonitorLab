@using MonitorLab.Web.Models.MonitorViewModels
@model IEnumerable<MonitorCardViewModel>

@{
    ViewData["Title"] = "Админ панел - Монитори";
}
<form asp-area="Admin"
      asp-controller="Monitors"
      asp-action="Dashboard"
      method="get"
      class="admin-search-bar">

    <div class="admin-form-group admin-search-group">
        <label>Търсене на монитор</label>
        <input name="searchTerm"
               value="@ViewData["SearchTerm"]"
               class="form-control"
               placeholder="Марка или модел..." />
    </div>

    <button type="submit" class="admin-add-btn">
        <i class="bi bi-search"></i>
        Търси
    </button>

    <a asp-area="Admin"
       asp-controller="Monitors"
       asp-action="Dashboard"
       class="admin-cancel-btn">
        Изчисти
    </a>
</form>

<section class="admin-panel-page">
    <div class="admin-panel-header">
        <span class="admin-login-badge">MonitorLab Admin</span>
        <h1>Управление на монитори</h1>
        <p>Преглед, добавяне, редакция и изтриване на мониторите в каталога.</p>
    </div>

    <div class="admin-actions-bar">
        <a asp-area="Admin"
               asp-controller="Monitors"
               asp-action="Create"
               class="admin-add-btn">
            <i class="bi bi-plus-circle"></i>
            Добави монитор
        </a>
    </div>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Модел</th>
                    <th>Резолюция</th>
                    <th>Панел</th>
                    <th>Hz</th>
                    <th>Яркост</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var monitor in Model)
                {
                    <tr>
                        <td>
                            <strong>@monitor.Brand @monitor.Model</strong>
                        </td>
                        <td>@monitor.Resolution</td>
                        <td>@monitor.PanelType</td>
                        <td>@monitor.RefreshRateHz Hz</td>
                        <td>@monitor.BrightnessNits nits</td>
                        <td>
                            <div class="admin-row-actions">
                                <a asp-area="Admin"
                                       asp-controller="Monitors"
                                       asp-action="Edit"
                                       asp-route-id="@monitor.Id"
                                       class="admin-edit-btn">
                                    <i class="bi bi-pencil-square"></i>
                                    Промяна
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@monitor.Id"
                                      asp-area="Admin"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="admin-delete-btn"
                                            onclick="return confirm('Сигурни ли сте, че искате да изтриете този монитор?');">
                                        <i class="bi bi-trash"></i>
                                        Изтрий
                                    </button>

                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>