@model LoginViewModel

@{
    ViewData["Title"] = "Администраторски вход";
}

<section class="admin-login-page">
    <div class="admin-login-card">
        <div class="admin-login-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <span class="admin-login-badge">MonitorLab Admin</span>

        <h1>Администраторски вход</h1>

        <p>
            Входът е предназначен за управление на съдържанието в системата.
        </p>

        <form id="account" method="post" class="admin-login-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="admin-form-group">
                <label asp-for="@Model.Email">Потребител</label>
                <input asp-for="@Model.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="admin@monitorlab.local" />
                <span asp-validation-for="@Model.Email" class="text-danger"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="@Model.Password">Парола</label>
                <input asp-for="@Model.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Въведете парола" />
                <span asp-validation-for="@Model.Password" class="text-danger"></span>
            </div>

            <div class="admin-login-options">
                <label asp-for="@Model.RememberMe">
                    <input asp-for="@Model.RememberMe" />
                    Запомни ме
                </label>
            </div>

            <button id="login-submit" type="submit" class="admin-login-btn">
                <i class="bi bi-box-arrow-in-right"></i>
                Вход
            </button>
        </form>

        <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="admin-back-link">
            <i class="bi bi-arrow-left"></i>
            Обратно към сайта
        </a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}